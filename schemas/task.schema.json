{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent OS Task",
  "description": "A unit of work tracked across the 5-stage pipeline.",
  "type": "object",
  "required": ["id", "title", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requested_by": {
      "type": "string",
      "description": "Who requested this task"
    },
    "status": {
      "type": "string",
      "enum": ["active", "blocked", "done", "cancelled"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"]
    },
    "stages": {
      "type": "object",
      "properties": {
        "discovery":   { "$ref": "#/definitions/stageRecord" },
        "planning":    { "$ref": "#/definitions/stageRecord" },
        "design":      { "$ref": "#/definitions/stageRecord" },
        "development": { "$ref": "#/definitions/stageRecord" },
        "qa":          { "$ref": "#/definitions/stageRecord" }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Functional and non-functional requirements captured in Stage 1",
      "items": {
        "type": "object",
        "required": ["id", "description", "type", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "description": { "type": "string" },
          "type": { "type": "string", "enum": ["functional", "non-functional", "constraint"] },
          "priority": { "type": "string", "enum": ["must", "should", "could"] }
        }
      }
    },
    "requirements_format": {
      "type": "string",
      "enum": ["req", "user-stories"],
      "description": "Format Stage 1 used for functional requirements (config preferences.requirements_format at that time). Missing = req."
    },
    "user_stories": {
      "type": "array",
      "description": "Functional requirements as user stories, only when requirements_format = user-stories. Non-functional requirements and constraints stay in requirements.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "capability", "benefit", "priority", "acceptance_criteria"],
        "description": "One user story: As a <role> I want <capability> so that <benefit>.",
        "properties": {
          "id": { "type": "string", "pattern": "^US-[0-9]+$", "description": "Story ID, e.g. US-001." },
          "role": { "type": "string", "description": "Who wants it (the 'As a ...' part)." },
          "capability": { "type": "string", "description": "What they want (the 'I want ...' part)." },
          "benefit": { "type": "string", "description": "Why (the 'so that ...' part)." },
          "priority": { "type": "string", "enum": ["must", "should", "could"], "description": "must = blocking, should = important, could = nice to have." },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "description": "Testable acceptance criteria, as Given/When/Then or as a checklist.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "description": "One acceptance criterion.",
              "properties": {
                "id": { "type": "string", "pattern": "^US-[0-9]+-AC[0-9]+$", "description": "Criterion ID, e.g. US-001-AC1." },
                "text": { "type": "string", "description": "The criterion, e.g. 'Given ..., when ..., then ...'." }
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Assumptions the requirements-analyst made instead of asking (Stage 1).",
      "items": { "type": "string", "description": "One assumption." }
    },
    "out_of_scope": {
      "type": "array",
      "description": "What is explicitly out of scope (Stage 1).",
      "items": { "type": "string", "description": "One out-of-scope item." }
    },
    "open_questions": {
      "type": "array",
      "description": "Questions that could not be resolved in Stage 1.",
      "items": { "type": "string", "description": "One open question." }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Plan-level data from Stage 2 (subtasks are in subtasks).",
      "properties": {
        "complexity": { "type": "string", "enum": ["simple", "medium", "complex"], "description": "Overall complexity assessed by the planner." },
        "risks": {
          "type": "array",
          "description": "Risks the planner identified.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "mitigation"],
            "description": "One risk.",
            "properties": {
              "description": { "type": "string", "description": "The risk." },
              "mitigation": { "type": "string", "description": "How it is handled." }
            }
          }
        },
        "external_dependencies": {
          "type": "array",
          "description": "Things outside the codebase the plan needs (APIs, credentials, migrations), with their status.",
          "items": { "type": "string", "description": "One dependency and its status." }
        },
        "scope_change": {
          "type": ["string", "null"],
          "description": "Work beyond the approved requirements the planner flagged, or null."
        }
      }
    },
    "subtasks": {
      "type": "array",
      "description": "Implementation subtasks defined in Stage 2",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "assigned_to": {
            "type": "string",
            "enum": ["backend-developer", "frontend-developer", "qa-engineer", "architect"]
          },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done"] },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requirements": {
            "type": "array",
            "description": "Requirement and story IDs this subtask fulfills (REQ-NNN, US-NNN or US-NNN-ACn).",
            "items": { "type": "string", "pattern": "^(REQ-[0-9]+|US-[0-9]+(-AC[0-9]+)?)$", "description": "Requirement, story or acceptance criterion ID." }
          },
          "criterion": {
            "type": "string",
            "description": "Verifiable completion criterion."
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of architecture decisions linked to this task (e.g. DEC-001)"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "created_at"],
        "properties": {
          "description": { "type": "string" },
          "created_at": { "type": "string" },
          "resolved_at": { "type": ["string", "null"] }
        }
      }
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of file paths modified during development"
    },
    "test_results": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "coverage": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  },
  "definitions": {
    "stageRecord": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "awaiting_approval", "done", "skipped"]
        },
        "started_at":   { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "approved_at":  { "type": ["string", "null"] },
        "approved_by": {
          "type": ["string", "null"],
          "enum": ["human", "approver", null],
          "description": "Who approved the stage's gate. approver only in autonomous mode for requirements and planning; design is always human. null for stages without a gate."
        },
        "review": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["verdict", "reviewed_at", "findings", "revisions"],
          "description": "Latest approver review of this stage. Only discovery and planning.",
          "properties": {
            "verdict": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES"], "description": "The approver's verdict." },
            "reviewed_at": { "type": "string", "format": "date-time", "description": "When the latest review finished." },
            "revisions": { "type": "integer", "minimum": 0, "description": "Times the producing agent was re-run with findings for this stage (approver or human change requests)." },
            "findings": {
              "type": "array",
              "description": "Findings of the latest review.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "severity", "finding", "proposed_change"],
                "description": "One finding.",
                "properties": {
                  "id": { "type": "string", "pattern": "^F-[0-9]+$", "description": "Finding ID, e.g. F-01." },
                  "severity": { "type": "string", "enum": ["blocker", "major", "minor"], "description": "blocker and major lead to REQUEST_CHANGES; minor alone does not." },
                  "target": { "type": "string", "description": "What it refers to: a REQ/US/SUB ID or a section name." },
                  "finding": { "type": "string", "description": "The problem." },
                  "proposed_change": { "type": "string", "description": "The concrete change the approver proposes." }
                }
              }
            }
          }
        },
        "change_requests": {
          "type": "array",
          "description": "Changes a human requested at this stage's gate, in order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_at", "text"],
            "description": "One change request.",
            "properties": {
              "requested_at": { "type": "string", "format": "date-time", "description": "When it was requested." },
              "text": { "type": "string", "description": "The requested changes, as the user wrote them." }
            }
          }
        },
        "output_summary": {
          "type": "string",
          "description": "1-3 sentence summary of what this stage produced"
        },
        "extension_warnings": {
          "type": "array",
          "description": "Warnings recorded when an agent's EXTENSIONS APPLIED section was missing or did not list every resolved extension path.",
          "items": { "type": "string", "description": "Warning text, e.g. 'backend-developer did not confirm applying: /abs/path/SKILL.md'." }
        }
      }
    }
  }
}
