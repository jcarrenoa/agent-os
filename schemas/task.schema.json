{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent OS Task",
  "description": "A unit of work tracked across the 5-stage pipeline.",
  "type": "object",
  "required": ["id", "title", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requested_by": {
      "type": "string",
      "description": "Who requested this task"
    },
    "status": {
      "type": "string",
      "enum": ["active", "blocked", "done", "cancelled"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"]
    },
    "stages": {
      "type": "object",
      "properties": {
        "discovery":   { "$ref": "#/definitions/stageRecord" },
        "planning":    { "$ref": "#/definitions/stageRecord" },
        "design":      { "$ref": "#/definitions/stageRecord" },
        "development": { "$ref": "#/definitions/stageRecord" },
        "qa":          { "$ref": "#/definitions/stageRecord" }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Functional and non-functional requirements captured in Stage 1",
      "items": {
        "type": "object",
        "required": ["id", "description", "type", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "description": { "type": "string" },
          "type": { "type": "string", "enum": ["functional", "non-functional", "constraint"] },
          "priority": { "type": "string", "enum": ["must", "should", "could"] }
        }
      }
    },
    "subtasks": {
      "type": "array",
      "description": "Implementation subtasks defined in Stage 2",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "assigned_to": {
            "type": "string",
            "enum": ["backend-developer", "frontend-developer", "qa-engineer", "architect"]
          },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done"] },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of architecture decisions linked to this task (e.g. DEC-001)"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "created_at"],
        "properties": {
          "description": { "type": "string" },
          "created_at": { "type": "string" },
          "resolved_at": { "type": ["string", "null"] }
        }
      }
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of file paths modified during development"
    },
    "test_results": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "coverage": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  },
  "definitions": {
    "stageRecord": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "awaiting_approval", "done", "skipped"]
        },
        "started_at":   { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "approved_at":  { "type": ["string", "null"] },
        "output_summary": {
          "type": "string",
          "description": "1-3 sentence summary of what this stage produced"
        }
      }
    }
  }
}
